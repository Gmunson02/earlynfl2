rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // True if users/{profileId} is a Family Member profile owned by the
    // caller (i.e. request.auth.uid manages it, even though it has no
    // Firebase Auth session of its own). Uses .get(key, default) since
    // most users/{uid} docs have no managedBy field at all.
    function isManagedBy(profileId) {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(profileId)) &&
             get(/databases/$(database)/documents/users/$(profileId)).data.get('managedBy', null) == request.auth.uid;
    }

    // ----------------------------
    // Profiles
    // Family Members are extra docs in this same collection, tagged
    // managedBy: <ownerUid>, instead of having their own Auth session.
    // ----------------------------
    match /users/{userId} {
      allow read: if request.auth != null;

      // Self-registration (real or guest account).
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !("managedBy" in request.resource.data);

      // Family Member profile creation — by the owner, or by an admin on
      // anyone's behalf.
      allow create: if request.auth != null
                    && "managedBy" in request.resource.data
                    && (request.resource.data.managedBy == request.auth.uid || isAdmin())
                    && request.resource.data.managedBy != userId
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() > 0
                    && request.resource.data.displayName.size() <= 40
                    && request.resource.data.keys().hasOnly(['displayName','theme','isGuest','managedBy']);

      allow update: if request.auth != null
                    && (
                         request.auth.uid == userId ||
                         isAdmin() ||
                         resource.data.get('managedBy', null) == request.auth.uid
                       )
                    && request.resource.data.keys().hasOnly(['displayName','firstName','lastName','theme','isGuest','managedBy','email','createdAt'])
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 40
                    // managedBy is immutable after create — no reassignment path
                    && request.resource.data.get('managedBy', null) == resource.data.get('managedBy', null);

      allow delete: if request.auth != null
                    && (
                         isAdmin() ||
                         resource.data.get('managedBy', null) == request.auth.uid
                       );
    }

    // ----------------------------
    // Picks
    // Old top-level fields (picks/{userId}) are read-only history now.
    // Live picks are one doc per week: picks/{userId}/weeks/{weekKey}
    // ----------------------------
    match /picks/{userId} {
      allow read: if request.auth != null;
      allow write: if false; // legacy doc; nothing writes here anymore

      match /weeks/{weekKey} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
                     && (
                       isAdmin() ||
                       ((request.auth.uid == userId || isManagedBy(userId)) && (
                         request.time < get(/databases/$(database)/documents/week_locks/$(weekKey)).data.locksAt ||
                         // Admin-granted temporary unlock (e.g. "5 minutes late" calls)
                         (resource != null && request.time < resource.data.adminUnlockUntil)
                       ))
                     );
      }
    }

    // ----------------------------
    // Collection-group read access for "weeks" subcollections.
    // Nested match rules above only apply to direct/scoped queries;
    // the results page runs a collectionGroup("weeks") query, which
    // Firestore requires this wildcard rule to permit.
    // ----------------------------
    match /{path=**}/weeks/{weekKey} {
      allow read: if request.auth != null;
    }

    // ----------------------------
    // Lock times for each week, admin-only write
    // ----------------------------
    match /week_locks/{weekKey} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ----------------------------
    // (Legacy) Leaderboard aggregate (public read-only)
    // ----------------------------
    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ----------------------------
    // Weekly results (public read-only)
    // ----------------------------
    match /weekly_results/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ----------------------------
    // Season leaderboard (public read-only)
    // ----------------------------
    match /season_leaderboard/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ----------------------------
    // Schedules (public read, admin-only write)
    // ----------------------------
    match /schedules/{seasonId} {
      allow read: if true;
      allow write: if isAdmin();

      match /weeks/{weekId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // ----------------------------
    // Admin ledger (balance/dues/winnings, real names) — admin-only in
    // both directions. Never merge into users/{uid}, which any signed-in
    // user can read.
    // ----------------------------
    match /admin_ledger/{userId} {
      allow read, write: if isAdmin();
    }

    // ----------------------------
    // Deny everything else by default
    // ----------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
